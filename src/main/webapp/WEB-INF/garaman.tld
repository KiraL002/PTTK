<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd" version="2.1">
    <tlib-version>1.0</tlib-version>
    <short-name>garaman</short-name>
    <uri>garaman</uri>
    <function>
        <name>money</name>
        <function-class>vn.garaman.web.ViewFunctions</function-class>
        <function-signature>java.lang.String money(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>quantity</name>
        <function-class>vn.garaman.web.ViewFunctions</function-class>
        <function-signature>java.lang.String quantity(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>date</name>
        <function-class>vn.garaman.web.ViewFunctions</function-class>
        <function-signature>java.lang.String date(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>dateInput</name>
        <function-class>vn.garaman.web.ViewFunctions</function-class>
        <function-signature>java.lang.String dateInput(java.lang.Object)</function-signature>
    </function>
</taglib>
